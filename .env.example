# ─── Backend (Express + SQLite) ──────────────────────────────────────────────
# Port the API server listens on
PORT=3001
# Path to the SQLite database file (created automatically if missing)
DATABASE_PATH=./data/church.db

# ─── Future database options ─────────────────────────────────────────────────

# PostgreSQL
# DATABASE_URL=postgresql://user:password@localhost:5432/church_scheduler

# Supabase
# VITE_SUPABASE_URL=https://yourproject.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key

# Firebase
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=

# App
# VITE_APP_NAME=Church Scheduler
