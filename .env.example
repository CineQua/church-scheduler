# ─── Server ──────────────────────────────────────────────────────────────────
# Environment: "development" or "production". In production, secure cookies and
# a strong JWT_SECRET are enforced.
NODE_ENV=development
# Port the API/server listens on.
PORT=3001

# ─── Database ────────────────────────────────────────────────────────────────
# Path to the SQLite database file (created automatically if missing).
#   Local dev default:  ./data/church-scheduler.sqlite
#   Docker/production:   /data/church-scheduler.sqlite  (mounted volume)
DATABASE_PATH=./data/church-scheduler.sqlite

# ─── Authentication ──────────────────────────────────────────────────────────
# Secret used to sign session tokens (JWT). REQUIRED in production and must be
# at least 32 characters. Generate one with:  openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
# How long a login stays valid (e.g. 7d, 24h, 30m).
JWT_EXPIRES_IN=7d

# ─── First Super Admin ───────────────────────────────────────────────────────
# Used by the seed step (and on first boot) to create the initial Super Admin.
# Has no effect once at least one user exists. Password must be >= 8 chars.
ADMIN_EMAIL=admin@yourchurch.org
ADMIN_PASSWORD=change-this-strong-password
ADMIN_NAME=Super Admin
